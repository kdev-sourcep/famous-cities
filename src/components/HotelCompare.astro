---
// Two-hotel compare box. Data is a snapshot from scripts/fetch-hotels.mjs (Google Hotels via SerpApi).
interface Props { slug: string }
type Price = { source: string; price: number; official: boolean; link: string };
type Hotel = { id: string; name: string; address: string; stars: number; rating: number; reviews: number; room: string; photo: string; freeCancellation: boolean; amenities: string[]; prices: Price[] };
type Snapshot = { city: string; checkIn: string; checkOut: string; adults: number; fetchedAt: string; hotels: Hotel[] };

const { slug } = Astro.props;
const files = import.meta.glob<{ default: Snapshot }>("../data/hotels/*.json", { eager: true });
const snap = files[`../data/hotels/${slug}.json`]?.default;

const KNOWN = ["Booking.com", "Expedia.com", "Hotels.com", "Agoda", "Priceline", "KAYAK.com", "Trip.com", "Hostelworld"];
const MAX_ROWS = 6;
const photoBase = import.meta.env.BASE_URL.replace(/\/$/, "") + `/hotel-photos/${slug}/`;
const fmt = (iso: string) => new Date(iso + "T12:00:00Z").toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });

const hotels = (snap?.hotels ?? []).map((h) => {
  const cheapest = h.prices[0];
  const rows = h.prices.filter((p, i) => i === 0 || p.official || KNOWN.includes(p.source)).slice(0, MAX_ROWS)
    .map((p) => ({ ...p, source: p.official ? "Hotel website" : p.source.replace(/\.com$/, (m) => (p.source === "Booking.com" || p.source === "Hotels.com" ? m : "")) }));
  return { ...h, photo: h.photo ? photoBase + h.photo : "", low: cheapest.price, sites: h.prices.length, rows };
});
---
{hotels.length >= 2 && snap && (
<div class="hcmp" data-hcmp>
  <div class="hcmp__head">
    <div><span class="eyebrow">Compare two hotels</span><h3>Side by side in {snap.city}</h3></div>
    <span class="hcmp__badge">{fmt(snap.checkIn)}–{fmt(snap.checkOut)} · {snap.adults} adults</span>
  </div>
  <script type="application/json" data-hcmp-data set:html={JSON.stringify(hotels)} />
  <div class="hcmp__grid">
    {[0, 1].map((slot) => (
      <div class="hcmp__col" data-slot={slot}>
        <select class="hcmp__select" aria-label={`Hotel ${slot + 1}`}>
          {hotels.map((h, i) => <option value={h.id} selected={i === slot}>{h.name}</option>)}
        </select>
        <div class="hcmp__card" data-card></div>
      </div>
    ))}
  </div>
  <p class="hcmp__verdict" data-verdict></p>
  <p class="hcmp__credit">Prices per night incl. taxes for {fmt(snap.checkIn)}–{fmt(snap.checkOut)}, {snap.adults} adults, from Google Hotels (checked {fmt(snap.fetchedAt)}). Prices change; confirm on the booking site.</p>
</div>
)}
<script>
  type Row = { source: string; price: number; link: string };
  type H = { id: string; name: string; address: string; stars: number; rating: number; reviews: number; room: string; photo: string; freeCancellation: boolean; amenities: string[]; low: number; sites: number; rows: Row[] };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  document.querySelectorAll<HTMLElement>("[data-hcmp]").forEach((root) => {
    const data: H[] = JSON.parse(root.querySelector("[data-hcmp-data]")!.textContent!);
    const cols = [...root.querySelectorAll<HTMLElement>(".hcmp__col")];
    const render = () => {
      const picked = cols.map((c) => data.find((h) => h.id === c.querySelector("select")!.value)!);
      const lows = picked.map((h) => h.low);
      cols.forEach((c, i) => {
        const h = picked[i];
        const best = h.rows[0];
        const rows = h.rows.map((r) =>
          `<li class="${r.price === h.low ? "is-best" : ""}"><a href="${esc(r.link)}" target="_blank" rel="sponsored noopener" class="book-btn" data-category="Compare"><span>${esc(r.source)}</span><strong>$${r.price}</strong>${r.price === h.low ? "<em>Cheapest</em>" : ""}</a></li>`).join("");
        const perks = [...(h.freeCancellation ? ["Free cancellation"] : []), ...h.amenities].slice(0, 3);
        c.querySelector("[data-card]")!.innerHTML = `
          <div class="hcmp__photo">${h.photo ? `<img src="${esc(h.photo)}" alt="${esc(h.room || "Room")} at ${esc(h.name)}" loading="lazy">` : ""}${h.stars ? `<span>${"★".repeat(h.stars)}</span>` : ""}</div>
          ${h.room ? `<p class="hcmp__area"><b>${esc(h.room.split(" - ")[0])}</b></p>` : ""}
          <p class="hcmp__area">${esc(h.address)}</p>
          <p class="hcmp__rating"><b>${h.rating}</b> / 5 · ${h.reviews.toLocaleString()} reviews</p>
          <ul class="hcmp__perks">${perks.map((p) => `<li>${esc(p)}</li>`).join("")}</ul>
          <p class="hcmp__label">Price per night · ${h.sites} sites checked</p>
          <ul class="hcmp__prices">${rows}</ul>
          <a class="btn btn--primary book-btn hcmp__book" href="${esc(best.link)}" target="_blank" rel="sponsored noopener" data-category="Compare">Book on ${esc(best.source)} · $${best.price}</a>`;
      });
      const [a, b] = picked;
      const diff = Math.abs(lows[0] - lows[1]);
      const cheaper = lows[0] <= lows[1] ? a : b;
      const better = a.rating >= b.rating ? a : b;
      root.querySelector("[data-verdict]")!.innerHTML = a.id === b.id ? "Pick two different hotels to compare."
        : `${diff ? `<b>${esc(cheaper.name)}</b> is $${diff} cheaper per night.` : "Both cost the same per night."} ${a.rating === b.rating ? "Both have the same guest rating." : `<b>${esc(better.name)}</b> has the higher guest rating.`}`;
    };
    cols.forEach((c) => c.querySelector("select")!.addEventListener("change", render));
    render();
  });
</script>
