---
import Icon from "./Icon.astro";
import { regions, citiesIn, cityHref, url, regionStyle, regionId } from "../lib/site";
const links = [
  { href: url("cities.html"), label: "All cities" },
  { href: url("best-cities-2026.html"), label: "Best Cities 2026" },
  { href: url("speed-tour.html"), label: "Speed's Tour" },
  { href: url("blog/blog.html"), label: "Guides" },
];
---
<header class="site-header">
  <div class="container">
    <a class="logo" href={url("")}><span class="logo__mark"><Icon name="globe" size={20} /></span>Famous Cities</a>
    <nav class="nav" aria-label="Main">
      <button class="nav__btn" type="button" aria-expanded="false" aria-controls="mega" data-mega-toggle>Destinations <Icon name="chevron-down" size={16} /></button>
      {links.map((l) => <a class="nav__link" href={l.href}>{l.label}</a>)}
    </nav>
    <span class="header-spacer"></span>
    <div class="search" data-search>
      <Icon name="search" size={16} />
      <input class="search__input" type="search" placeholder="Search cities" aria-label="Search cities" autocomplete="off" role="combobox" aria-expanded="false" aria-autocomplete="list" />
      <ul class="search__list" role="listbox" hidden></ul>
    </div>
    <button class="theme-btn" type="button" aria-pressed="false" aria-label="Dark mode" data-theme-toggle><span data-when="light"><Icon name="moon" size={16} /><b>Dark</b></span><span data-when="dark"><Icon name="sun" size={16} /><b>Light</b></span></button>
    <a class="btn btn--primary btn--sm btn--support" href={url("support.html")}><Icon name="heart" size={16} /> Support</a>
    <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" data-drawer-open><Icon name="menu" size={20} /></button>
  </div>
  <div class="mega" id="mega" hidden>
    <div class="container mega__grid">
      {regions.map((r) => (
        <div class="mega__col" style={regionStyle(r.name)}>
          <h3><span class="dot"></span>{r.name}</h3>
          <ul>{citiesIn(r.name).map((c) => <li><a href={cityHref(c.slug)}>{c.name}</a></li>)}</ul>
        </div>
      ))}
    </div>
  </div>
  <div class="drawer" hidden data-drawer>
    <div class="drawer__scrim" data-drawer-close></div>
    <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="drawer__top">
        <a class="logo" href={url("")}><span class="logo__mark"><Icon name="globe" size={20} /></span>Famous Cities</a>
        <button class="menu-btn" style="display:inline-flex" type="button" aria-label="Close menu" data-drawer-close><Icon name="x" size={20} /></button>
      </div>
      <div class="search" data-search>
        <Icon name="search" size={16} />
        <input class="search__input" type="search" placeholder="Search cities" aria-label="Search cities" autocomplete="off" role="combobox" aria-expanded="false" aria-autocomplete="list" />
        <ul class="search__list" role="listbox" hidden></ul>
      </div>
      <button class="theme-btn" type="button" aria-pressed="false" aria-label="Dark mode" data-theme-toggle><span data-when="light"><Icon name="moon" size={16} /><b>Dark</b></span><span data-when="dark"><Icon name="sun" size={16} /><b>Light</b></span></button>
      <div class="drawer__links">{links.map((l) => <a href={l.href}>{l.label}</a>)}</div>
      <div>
        {regions.map((r) => (
          <details style={regionStyle(r.name)} id={`drawer-${regionId(r.name)}`}>
            <summary><span class="dot"></span>{r.name}<Icon name="chevron-down" size={16} /></summary>
            <ul>{citiesIn(r.name).map((c) => <li><a href={cityHref(c.slug)}>{c.name}</a></li>)}</ul>
          </details>
        ))}
      </div>
      <a class="btn btn--primary" href={url("support.html")}><Icon name="heart" size={16} /> Support Famous Cities</a>
    </div>
  </div>
</header>
