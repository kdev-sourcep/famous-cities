---
import Icon from "./Icon.astro";
import { categories, CATEGORY_ICONS, CATEGORY_COLORS, url } from "../lib/site";
interface Props { active?: string[] }
const { active = [] } = Astro.props;
---
<section class="legend" aria-labelledby="legend-title">
  <h2 id="legend-title" class="legend__title">Legend</h2>
  <ul class="legend__grid">
    {categories.map((c) => (
      <li><a class:list={["legend__item", { "is-active": active.includes(c.key) }]} href={url(`Best-City-Image-Swap.html#${c.key}`)} style={CATEGORY_COLORS[c.key]}>
        <span class="tile"><Icon name={CATEGORY_ICONS[c.key]} size={20} /></span>{c.label}
      </a></li>
    ))}
  </ul>
</section>
