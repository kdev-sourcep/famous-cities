---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import pages from "../data/pages.json";
import { rich, KOFI_URL, GOFUNDME_URL } from "../lib/site";
const p = pages.support;
---
<BaseLayout title={p.title} description={p.description} path="support.html">
  <section class="page-hero page-hero--center"><div class="container"><span class="eyebrow">Support</span><h1>{p.heading}</h1></div></section>
  <section class="section">
    <div class="container prose">
      <Fragment set:html={rich(p.html)} />
      <div class="donate-row" id="sec-donate">
        <a class="btn btn--kofi donate-btn" href={KOFI_URL} target="_blank" rel="noopener"><span aria-hidden="true">☕</span> Support on Ko-fi</a>
        <a class="btn btn--gofundme gofundme-btn" href={GOFUNDME_URL} target="_blank" rel="noopener"><span aria-hidden="true">❤️</span> Support on GoFundMe</a>
      </div>
    </div>
  </section>
</BaseLayout>
