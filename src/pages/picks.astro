---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import PickRestaurants from "../components/PickRestaurants.astro";
import w from "../data/weekly.json";
import { cities, cityHref, url } from "../lib/site";
const city = cities.find((c) => c.slug === w.city)!;
const cityImg = url(`cards/${city.slug}.webp`);
---
<BaseLayout title={`This Week's Picks: Where to Eat in ${city.name} & Fundraisers to Support | Famous Cities`} description={`5 local restaurants in ${city.name} and 5 fundraisers worth supporting, picked by Famous Cities for the week of ${w.week}.`} path="picks.html">
  <section class="page-hero page-hero--center"><div class="container">
    <span class="eyebrow">Week of {w.week}</span>
    <h1>This week's picks</h1>
    <p class="lead">5 local restaurants and 5 fundraisers, picked every week.</p>
  </div></section>

  <section class="section"><div class="container">
    <div class="picks-banner" style={`background-image: linear-gradient(90deg, rgba(10,12,30,.78), rgba(10,12,30,.15)), url(${cityImg})`}>
      <span class="eyebrow">Where to eat</span><h2>5 local restaurants in {city.name}</h2><p>Independent spots, no chains. <a href={cityHref(city.slug)}>Read our {city.name} guide</a>.</p>
    </div>
    <PickRestaurants />
  </div></section>

  <section class="section section--surface"><div class="container">
    <div class="section-head"><div><span class="eyebrow">Fundraisers</span><h2>5 causes worth supporting</h2><p>Run by registered charities and relief organizations.</p></div></div>
    <div class="picks-grid">
      {w.fundraisers.map((f) => (
        <article class="card pick-card">
          <div class="pick-card__top"><span class="pick-tag pick-tag--give">{f.tag}</span></div>
          <h3>{f.name}</h3>
          <p class="pick-card__area muted">{f.org}</p>
          <p>{f.desc}</p>
          <a class="btn btn--dark btn--sm" data-category="Picks" href={f.url} target="_blank" rel="noopener">Donate on their site</a>
        </article>
      ))}
    </div>
    <p class="muted picks-note">Picks are chosen by Famous Cities. Nobody pays to be listed and we earn nothing from these links. Donations go directly to each organization through its own website; check their page before you give. <a href={url("support.html")}>Want to support Famous Cities itself?</a></p>
  </div></section>
</BaseLayout>
