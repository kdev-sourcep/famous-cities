---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { url } from "../lib/site";
const email = "thekunsaw@gmail.com";
const payLink = "https://buy.stripe.com/9B6eVebNO62la8O8iygbm00";
const subject = "Authentic Dining Feature Request – [Restaurant Name] ([City, State])";
const letter = `Hi Famous Cities team,

We would love to be featured as an authentic local dining destination on your [City, State] travel and city guide page. Since your visitors are planning vacations and exploring what makes [City, State] famous, we believe our food offers travelers a genuine taste of the local culture.

Here are the details and assets for our restaurant feature card:

- Restaurant Name: [Official Business Name]
- City & State: [e.g., Pensacola, Florida]
- Street Address: [Full Address]
- What Makes Our Food Authentic (1–2 sentences): [e.g., Family-owned for 30 years, serving fresh, locally caught Gulf seafood and traditional coastal recipes.]
- Signature Dish / Cuisine Type: [e.g., Authentic Gulf Seafood / Traditional Southern]
- Clickable Menu Link (URL): [Direct link to online menu or PDF]
- Plan: City Spotlight ($25/month), paid with this email address
- Contact Name & Role: [Owner / Manager Name]
- Email & Phone Number: [Best Contact Info]

Photo Attachment & Permission:
I have attached a high-resolution photo showcasing our restaurant and authentic cuisine for our clickable feature card. I confirm that we own the rights to this photo and grant Famous Cities (famouscities.world) permission to display it on the website.

Please let us know if you need anything else to get our menu featured for your travelers.

Best regards,
[Owner/Manager Name]
[Restaurant Name]
[Restaurant Website / Social Media Handle]`;
const mailto = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(letter)}`;
---
<BaseLayout title="Feature your restaurant | Famous Cities" description="Showcase your authentic local cuisine to travelers planning trips. Send us your restaurant details and menu link to be featured on a Famous Cities city guide." path="feature-restaurant.html">
  <section class="page-hero page-hero--center"><div class="container">
    <span class="eyebrow">For restaurants</span>
    <h1>Showcase your authentic local cuisine to visitors</h1>
    <p>Become a culinary stop on our city guides.</p>
  </div></section>
  <section class="section"><div class="container">
    <div class="feature-why">
      <div class="card feature-why__item"><Icon name="plane" /><h3>Travelers, not scrollers</h3><p>Our visitors are booking hotels and planning trips, and they want authentic local food instead of generic chains.</p></div>
      <div class="card feature-why__item"><Icon name="landmark" /><h3>Cultural discovery</h3><p>Your restaurant appears as part of what makes your city famous, right next to its top sights and things to do.</p></div>
      <div class="card feature-why__item"><Icon name="image" /><h3>A visual, clickable card</h3><p>Your photo leads straight to your menu, so visitors can plan where to eat before they even arrive in town.</p></div>
    </div>
    <div class="section-head feature-head"><div><span class="eyebrow">Pricing</span><h2>City Spotlight</h2></div></div>
    <div class="feature-tiers feature-tiers--one">
      <div class="card feature-tier feature-tier--top"><span class="pick-tag">Sponsored</span><h3>City Spotlight</h3><p class="feature-tier__price">$25<span>/month</span></p><ul><li>Photo card on your city's page, labeled "Sponsored"</li><li>Clicks go straight to your menu</li><li>Only independent restaurants, max 12 per city</li><li>Cancel any time; your card is removed when the subscription ends</li></ul>
        {payLink && <a class="btn btn--dark btn--sm" href={payLink} target="_blank" rel="noopener">Pay $25/month &amp; apply</a>}
      </div>
    </div>
    <p class="muted picks-note">How it works: 1) Subscribe with the button above. 2) Email us the letter below from the same email address you paid with. 3) We review it and, once approved, your card goes live within a couple of days. If we can't approve your restaurant, we refund your payment. Our weekly picks are chosen independently and can't be bought.</p>
    <div class="section-head feature-head"><div><span class="eyebrow">How to apply</span><h2>Send us this letter</h2><p>Fill in the brackets, attach a photo you own, and email it from the address you paid with to <a href={`mailto:${email}`}>{email}</a>.</p></div></div>
    <div class="card feature-letter">
      <p class="feature-letter__subject"><strong>Subject:</strong> {subject}</p>
      <pre id="feature-letter">{letter}</pre>
      <div class="trip-card__links">
        <a class="btn btn--dark btn--sm" href={mailto}><Icon name="mail" /> Email us this letter</a>
        <button type="button" class="btn btn--light btn--sm" id="copy-letter">Copy letter</button>
      </div>
    </div>
    <p class="muted picks-note">See who's featured right now on <a href={url("picks.html")}>This week's picks</a>.</p>
  </div></section>
  <script is:inline>
    document.getElementById("copy-letter").addEventListener("click", function () {
      var b = this, t = "Subject: " + document.querySelector(".feature-letter__subject").textContent.replace(/^Subject:\s*/, "") + "\n\n" + document.getElementById("feature-letter").textContent;
      navigator.clipboard.writeText(t).then(function () { b.textContent = "Copied!"; setTimeout(function () { b.textContent = "Copy letter"; }, 2000); });
    });
  </script>
</BaseLayout>
