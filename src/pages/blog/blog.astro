---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import pages from "../../data/pages.json";
import guides from "../../data/guides.json";
import { url, absUrl } from "../../lib/site";
const posts = (["dubai-3-day-budget", "dubai-layover-guide"] as const).map((k) => ({ slug: k, ...pages[k] }));
const jsonld = [{ "@type": "Blog", "name": "Famous Cities travel guides", "url": absUrl("blog/blog.html"), "blogPost": posts.map((p) => ({ "@type": "BlogPosting", "headline": p.heading, "url": absUrl(`blog/${p.slug}.html`) })) }];
---
<BaseLayout title="Travel Guides | Famous Cities" description="Famous Cities travel guides: the best cities in Spain, India, the Netherlands, Poland and South Korea, famous movie and football cities, plus budget and layover guides." path="blog/blog.html" jsonld={jsonld}>
  <section class="page-hero"><div class="container"><span class="eyebrow">Guides</span><h1>Travel guides</h1><p>Where to go, what each city does best and practical money-saving tips.</p></div></section>
  <section class="section">
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">Where to go</span><h2>City collections</h2></div></div>
      <div class="grid grid--3">
        {guides.map((g) => (
          <a class="card post-card" href={url(`guides/${g.slug}.html`)} style="--c1:#0EA5E9;--c2:#6366F1">
            <img class="post-card__img" src={url(`cards/${g.items[0].slug}.webp`)} alt="" width="560" height="340" loading="lazy" decoding="async" />
            <span class="chip">{g.kicker}</span>
            <h2>{g.title}</h2>
            <p class="muted">{g.description}</p>
            <span class="post-card__more">Read guide<Icon name="arrow-right" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section section--surface">
    <div class="container"><div class="section-head"><div><span class="eyebrow">Plan smarter</span><h2>Budget and layover guides</h2></div></div></div>
    <div class="container grid grid--2">
      {posts.map((p) => (
        <a class="card post-card" href={url(`blog/${p.slug}.html`)} style="--c1:#F59E0B;--c2:#FB7185">
          <span class="tile"><Icon name="book-open" size={20} /></span>
          <span class="chip">Dubai</span>
          <h2>{p.heading}</h2>
          <p class="muted">{p.description}</p>
          <span class="post-card__more">Read guide<Icon name="arrow-right" size={16} /></span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
